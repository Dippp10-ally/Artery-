# ────────────────────────────────────────────────────────────────────────────
# ARTERY — Environment Variables
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git — it is already in .gitignore.
# ────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...        # "anon public" key (safe to expose)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...            # "service_role" key — SERVER ONLY, never in NEXT_PUBLIC_*

# ── OpenAI (DALL-E 3 image generation) ───────────────────────────────────────
# platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Razorpay (payment processing) ────────────────────────────────────────────
# dashboard.razorpay.com → Settings → API Keys
# Use rzp_test_... during development, rzp_live_... in production
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...    # Settings → Webhooks → Webhook Secret

# ── Anthropic (Fabri AI curator) ─────────────────────────────────────────────
# console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── App ───────────────────────────────────────────────────────────────────────
# Full URL of deployed site — no trailing slash
# Used for: sitemap, og:url, CORS headers, Razorpay callbacks
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ── Rate Limiting (optional — protects /api/generate from abuse) ──────────────
# Free tier at upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ── Supabase Phone OTP (optional — needs Twilio connected in Supabase Auth) ───
# Supabase Dashboard → Auth → Providers → Phone → Twilio
# (No env vars needed here — configured entirely in Supabase dashboard)
